{
  "name": "the-accounts",
  "version": "0.1.0",
  "description": "Cook Swift - Restaurant POS & Management System",
  "author": "Cook Swift",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --experimental-https",
    "electron:dev": "concurrently \"next dev -p 3000\" \"wait-on -t 60000 http://localhost:3000 && electron .\"",
    "electron:start": "electron .",
    "electron:build": "next build --webpack && node scripts/prepare_standalone.js && npx electron-builder@25.1.8 --win --dir && node scripts/patch-electron-runtime.js && npx electron-builder@25.1.8 --win nsis --prepackaged dist-electron/win-unpacked",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "types:gen": "node scripts/regen-database-types.mjs",
    "test:phase1": "node scripts/test-phase1-access.mjs",
    "test:offline": "node scripts/test-offline-checklist.mjs",
    "test:reports": "node scripts/test-phase5-reports.mjs",
    "test:sidebar-themes": "node scripts/test-sidebar-themes.mjs",
    "ci": "npm run typecheck && npm run test:phase1 && npm run test:offline && npm run test:reports && npm run test:sidebar-themes"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@neon/auth": "^0.8.2",
    "@neondatabase/serverless": "^1.2.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.41.0",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pdf-to-printer": "^5.8.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.10",
    "electron": "^32.2.8",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.cookswift.pos",
    "productName": "Cook Swift",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cook Swift"
    }
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "core-js@3.49.0": true,
    "unrs-resolver@1.12.2": true,
    "better-sqlite3@13.0.3": true,
    "electron@32.2.8": true
  }
}
